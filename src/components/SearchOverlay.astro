---
import searchIndex from '../data/search-index.json';
---
<div id="search-overlay">
  <div id="search-modal">
    <div id="search-input-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search-input" type="text" placeholder="Search sections, rules, requirements, checklist items…" autocomplete="off" />
      <kbd>Esc</kbd>
    </div>
    <div id="search-results"></div>
  </div>
</div>
<script is:inline define:vars={{ searchIndex, base: import.meta.env.BASE_URL }}>
  window.SEARCH_INDEX = searchIndex.map(function (item) {
    var page = item.page;
    if (page === '/') page = base;
    else if (page.startsWith('/')) page = base.replace(/\/$/, '') + page;
    return Object.assign({}, item, { page: page });
  });
  window.SITE_BASE = base;
</script>

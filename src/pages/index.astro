---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import '../styles/hub.css';

const base = import.meta.env.BASE_URL;
const handbook = 'https://saabbir.github.io/shopify-theme-handbook/';
const cards = [
  {
    id: 'scorecard',
    step: 'Step 1',
    title: 'Submission Scorecard',
    body: 'Mark every Theme Store requirement Pass, Fail, or N/A. Filter fails and export markdown for your PR.',
    href: `${base}scorecard/`,
    storage: 'scorecard',
    cta: 'Open scorecard',
  },
  {
    id: 'checklist',
    step: 'Step 2',
    title: 'Development Checklist',
    body: 'Tick storefront QA by area — home, header, pages, selling plans, and more. Progress saves in this browser.',
    href: `${base}checklist/`,
    storage: 'checklist',
    cta: 'Open checklist',
  },
  {
    id: 'packaging',
    step: 'Step 3',
    title: 'Packaging Gate',
    body: 'Final zip checklist before Partner Dashboard upload: cleanup, exclusions, version notes, Lighthouse gates.',
    href: `${base}packaging/`,
    storage: 'packaging',
    cta: 'Open packaging',
  },
  {
    id: 'rejections',
    step: 'Diagnose',
    title: 'Rejection Autopsy',
    body: 'Match a common rejection reason to the scorecard item and handbook chapter that fixes it.',
    href: `${base}rejections/`,
    storage: null,
    cta: 'Browse rejections',
  },
];
---
<BaseLayout
  title="Theme Store Checklist — Submission Toolkit"
  description="Day-of-submission toolkit for Shopify Theme Store themes: scorecard, QA checklist, packaging gate, and rejection autopsy. Companion to the Theme Handbook."
  pageId="hub"
  scripts={[`${base}scripts/hub.js`]}
>
  <TopNav slot="topnav" active="hub" />
  <Sidebar
    slot="sidebar"
    active="hub"
    logoTitle="Today’s run"
    logoSub="Submission toolkit"
    hideToc={true}
  />

  <div class="hub-hero page-header">
    <span class="eyebrow">Companion to the Theme Handbook</span>
    <h1>Theme Store Checklist</h1>
    <p>Use this toolkit on submission week: score the official rules, run QA, package the zip, and diagnose rejections. For architecture, Liquid, and AI workflow, use the handbook.</p>
  </div>

  <div class="hub-grid">
    {cards.map((card) => (
      <a class="hub-card" href={card.href} data-hub-card={card.storage || ''}>
        <div class="step">{card.step}</div>
        <h2>{card.title}</h2>
        <p>{card.body}</p>
        <div class="meta">
          <span>
            {card.storage ? (
              <>Progress <strong data-hub-pct={card.storage}>—</strong></>
            ) : (
              <>Diagnostic index</>
            )}
          </span>
          <span class="cta">{card.cta} →</span>
        </div>
      </a>
    ))}
  </div>

  <div class="hub-note">
    Deep standards and “why” live in the <a href={handbook} target="_blank" rel="noopener noreferrer">Shopify Theme Handbook</a>. This site stays short, tickable, and exportable.
  </div>

  <Footer slot="footer" note="Theme Store Checklist · Hub · day-of-submission toolkit." />
  <SearchOverlay slot="search" />
</BaseLayout>
